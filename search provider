METHOD if_rap_query_provider~select.

  DATA(lo_filter) = io_request->get_filter( ).
  DATA(lo_paging) = io_request->get_paging( ).
  DATA(lt_sort)   = io_request->get_sort_elements( ).

  DATA(lv_top)  = lo_paging->get_page_size( ).
  DATA(lv_skip) = lo_paging->get_offset( ).

  DATA lt_response TYPE TABLE OF zce_edar_result.

  IF io_request->is_total_numb_of_rec_requested( ).
    io_response->set_total_number_of_records(
      lines( lt_response )
    ).
  ENDIF.

  io_response->set_data( lt_response ).

ENDMETHOD.



DATA ls_option TYPE sqf_se16_select_option.

ls_option-fieldname = 'PROCESS_TYPE'.
ls_option-sign      = 'I'.
ls_option-option    = 'EQ'.
ls_option-low       = 'YDA5'.

APPEND ls_option TO lt_options.
