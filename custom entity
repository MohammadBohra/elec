METHOD if_rap_query_provider~select.

  DATA lt_response TYPE TABLE OF zce_edar_result.

  IF io_request->is_total_numb_of_rec_requested( ).
    io_response->set_total_number_of_records( 1 ).
  ENDIF.

  APPEND VALUE #(
    Guid                 = '12345678901234567890123456789012'
    ObjectId             = '123456'
    ProcessType          = 'YDA'
    ProcessTypeTxt       = 'TEST'
    StatLifecycle        = '0065'
    StatLifecycleDesc    = 'Approved'
    SoldToPartyList      = 'Test'
    ContactPersonList    = 'Test'
    Currency             = 'AED'
  ) TO lt_response.

  io_response->set_data( lt_response ).

ENDMETHOD.
